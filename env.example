# Required: the only data-provider credential used by the application.
DEEPLINE_API_KEY=

# Optional: override the Deepline API origin for local or self-hosted testing.
INBOUND_DEMO_DEEPLINE_API_BASE_URL=https://code.deepline.com

# Optional UI and production-demo infrastructure.
# Production fails closed when the access password is absent.
INBOUND_DEMO_ACCESS_PASSWORD=
# Brandfetch client IDs are public identifiers, not API keys.
INBOUND_DEMO_BRANDFETCH_CLIENT_ID=

# Optional: persists background enrichment for client-side polling.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional post-response Deepline Plays.
INBOUND_DEMO_ASYNC_PLAY_NAME=inbound-lead-async-routing

# Optional HubSpot-owner-to-calendar mappings. HubSpot access is configured in
# the Deepline workspace; the application does not require a HubSpot token.
INBOUND_DEMO_HUBSPOT_OWNER_JAI_IDS=
INBOUND_DEMO_HUBSPOT_OWNER_ANAND_IDS=
INBOUND_DEMO_HUBSPOT_OWNER_CHIRAG_IDS=

# Optional custom HubSpot contact properties for fill-only revenue/calendar sync.
INBOUND_DEMO_HUBSPOT_CONTACT_REVENUE_PROPERTY=
INBOUND_DEMO_HUBSPOT_CONTACT_CALENDAR_PROPERTY=
